{
    "name": "desk-share-viewer",
    "type": "module",
    "version": "0.1.3",
    "private": true,
    "description": "macOS 桌面屏幕共享 + 虚拟显示器一体工具，主机端 Electron app，观众端浏览器，LAN P2P 推流。DeskPad + Deskreen 思路融合。",
    "author": {
        "name": "nowo",
        "email": "z8888788@163.com",
        "url": "https://github.com/nowo"
    },
    "license": "MIT",
    "homepage": "https://github.com/nowo/desk-share-viewer",
    "repository": {
        "type": "git",
        "url": "https://github.com/nowo/desk-share-viewer.git"
    },
    "bugs": {
        "url": "https://github.com/nowo/desk-share-viewer/issues"
    },
    "keywords": [
        "electron",
        "macos",
        "screen-sharing",
        "screen-share",
        "webrtc",
        "virtual-display",
        "deskpad",
        "deskreen",
        "desktop-app",
        "p2p"
    ],
    "main": "dist-electron/main.cjs",
    "scripts": {
        "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:ws --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
        "build:electron:watch": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --external:ws --outdir=dist-electron --out-extension:.js=.cjs --watch=forever",
        "dev": "bash prep-sidecars.sh && pnpm run build:electron && concurrently -k -n vite,electron \"vite\" \"wait-on http://localhost:1420 && cross-env VITE_DEV_SERVER_URL=http://localhost:1420 electron .\"",
        "build": "bash prep-sidecars.sh universal && vue-tsc --noEmit && pnpm run build:electron && vite build && electron-builder --publish never",
        "build:nopack": "bash prep-sidecars.sh universal && vue-tsc --noEmit && pnpm run build:electron && vite build",
        "preview": "vite preview",
        "release": "changelogen --release --push --no-github",
        "lint": "eslint . --fix"
    },
    "dependencies": {
        "qrcode": "^1.5.4",
        "vue": "^3.5.13",
        "vue-router": "^4.4.5",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.0.0",
        "@iconify-json/mdi": "^1.2.3",
        "@types/node": "^22.10.5",
        "@types/qrcode": "^1.5.5",
        "@types/ws": "^8.5.13",
        "@unocss/eslint-config": "^66.7.0",
        "@unocss/preset-icons": "^66.7.0",
        "@unocss/preset-wind4": "^66.0.0",
        "@vitejs/plugin-vue": "^5.2.1",
        "changelogen": "^0.6.2",
        "concurrently": "^10.0.3",
        "cross-env": "^10.1.0",
        "electron": "^33.2.1",
        "electron-builder": "^25.1.8",
        "esbuild": "^0.28.0",
        "eslint": "^10.4.1",
        "typescript": "^5.6.3",
        "unocss": "^66.0.0",
        "vite": "^6.0.7",
        "vue-tsc": "^3.1.1",
        "wait-on": "^9.0.10"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "electron",
            "esbuild"
        ]
    }
}
